# Miarch · notificaciones (dunst). Los colores salen del wallpaper: los escribe miarch-colors en dunstrc.d/50-miarch-colores.conf
[global]
    # sitio y tamaño: arriba a la derecha, bajo la barra
    follow = mouse
    origin = top-right
    offset = (16, 54)
    width = (300, 400)
    height = (0, 220)
    notification_limit = 5
    gap_size = 10
    # forma
    corner_radius = 16
    frame_width = 1
    padding = 16
    horizontal_padding = 18
    text_icon_padding = 14
    separator_height = 0
    # texto
    font = JetBrainsMono Nerd Font 11
    markup = full
    format = "<span size='small' alpha='65%%'>%a</span>\n<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    ellipsize = end
    word_wrap = yes
    show_age_threshold = -1
    hide_duplicate_count = true
    stack_duplicates = true
    # iconos
    icon_position = left
    min_icon_size = 40
    max_icon_size = 48
    icon_corner_radius = 10
    enable_recursive_icon_lookup = true
    icon_theme = breeze-dark, Adwaita
    # barra de progreso (volumen, brillo…)
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 4
    progress_bar_min_width = 150
    progress_bar_horizontal_alignment = center
    # ratón: clic izquierdo cierra, central ejecuta la acción, derecho cierra todas
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all
    sticky_history = yes
    history_length = 30

[urgency_low]
    timeout = 4

[urgency_normal]
    timeout = 7

[urgency_critical]
    timeout = 0
