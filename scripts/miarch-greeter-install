#!/usr/bin/env bash
# Miarch · instala la pantalla de inicio de sesión gráfica (greetd + Quickshell).
# Ejecútalo con tu usuario normal (pide sudo). NO la activa hasta el próximo reinicio.
#
# Si algo falla y no puedes entrar: Ctrl+Alt+F2, inicia sesión con tu usuario y ejecuta
#     sudo systemctl disable greetd && sudo systemctl enable getty@tty1
# y reinicia: vuelves al inicio de sesión de texto de siempre.
set -euo pipefail

[ "$EUID" -ne 0 ] || { echo "[ERROR] Ejecútalo con tu usuario normal, no como root."; exit 1; }
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SRC="$REPO/config/greeter"
DEST=/usr/share/miarch/greeter
DATOS=/var/lib/miarch-greeter

for f in shell.qml hyprland.lua start.sh config.toml; do
    [ -f "$SRC/$f" ] || { echo "[ERROR] Falta $SRC/$f"; exit 1; }
done
command -v qs >/dev/null || { echo "[ERROR] Falta quickshell (ejecuta ./packages.sh primero)"; exit 1; }

echo "==> Instalando greetd..."
sudo pacman -S --needed --noconfirm greetd

echo "==> Copiando la pantalla de inicio de sesión a $DEST ..."
KB="$(grep -oP '^local KB *= *"\K[^"]+' "$HOME/.config/hypr/hyprland.lua" 2>/dev/null || echo latam)"
sudo install -d -m 755 "$DEST"
sudo install -m 644 "$SRC/shell.qml" "$DEST/shell.qml"
sed "s/__KB__/$KB/" "$SRC/hyprland.lua" | sudo tee "$DEST/hyprland.lua" >/dev/null
sudo chmod 644 "$DEST/hyprland.lua"
sudo install -m 755 "$SRC/start.sh" "$DEST/start.sh"

echo "==> Carpeta del fondo y los colores (la actualiza wallpaper.sh sin necesitar sudo)..."
sudo install -d -o "$USER" -g "$(id -gn)" -m 755 "$DATOS"
[ -s "$HOME/.cache/miarch-wallpaper" ] && cp -f "$(cat "$HOME/.cache/miarch-wallpaper")" "$DATOS/wallpaper" && chmod 644 "$DATOS/wallpaper"
[ -f "$HOME/.cache/miarch/colors.json" ] && cp -f "$HOME/.cache/miarch/colors.json" "$DATOS/colors.json" && chmod 644 "$DATOS/colors.json"

echo "==> Configurando greetd (guardo una copia de la config anterior)..."
[ -f /etc/greetd/config.toml ] && sudo cp -n /etc/greetd/config.toml /etc/greetd/config.toml.miarch-bak
sudo install -m 644 "$SRC/config.toml" /etc/greetd/config.toml

echo "[OK] Activando greetd para el próximo arranque (no se inicia ahora)..."
sudo systemctl enable greetd.service

echo ""
echo "Listo. Al reiniciar verás la pantalla de inicio de sesión gráfica."
echo "Para deshacerlo: sudo systemctl disable greetd && sudo systemctl enable getty@tty1"
