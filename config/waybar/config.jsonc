// Miarch - Waybar mate · islas en cápsula partida (bloque de color + valor)
{
    "layer": "top",
    "position": "top",
    "height": 36,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 8,
    "exclusive": true,
    "reload_style_on_change": true,

    "modules-left":   ["custom/launcher", "hyprland/workspaces", "group/music"],
    "modules-center": ["group/time"],
    "modules-right":  ["group/system", "group/connect", "group/sound", "group/power-cell", "tray", "custom/power"],

    // ═════════ LANZADOR ═════════
    "custom/launcher": {
        "format": "󰣇",
        "tooltip-format": "Clic: apps · Clic derecho: cambiar wallpaper",
        "on-click": "rofi -show drun",
        "on-click-right": "~/.local/bin/wallpaper.sh"
    },

    // ═════════ ESCRITORIOS ═════════
    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1",
        "persistent-workspaces": { "*": 5 }
    },

    // ═════════ MÚSICA (solo aparece si hay algo sonando) ═════════
    "group/music": {
        "orientation": "horizontal",
        "modules": ["custom/music-icon", "mpris", "custom/music-prev", "custom/music-play", "custom/music-next"]
    },
    "custom/music-icon": {
        "exec": "~/.config/waybar/scripts/music-icon.sh",
        "return-type": "json",
        "interval": 2,
        "on-click": "playerctl play-pause",
        "tooltip": false
    },
    "mpris": {
        "format": "{title} <span alpha='60%'>· {artist}</span>",
        "format-paused": "<i>{title}</i> <span alpha='45%'>· {artist}</span>",
        "title-len": 24,
        "artist-len": 16,
        "tooltip-format": "{player}: {title}\n{artist} — {album}\n{position} / {length}",
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl volume 0.05+",
        "on-scroll-down": "playerctl volume 0.05-"
    },
    "custom/music-prev": {
        "format": "󰒮",
        "exec-if": "playerctl status 2>/dev/null",
        "exec": "echo",
        "interval": 2,
        "on-click": "playerctl previous",
        "tooltip": false
    },
    "custom/music-play": {
        "exec": "s=$(playerctl status 2>/dev/null); [ \"$s\" = Playing ] && echo '󰏤' || echo '󰐊'",
        "exec-if": "playerctl status 2>/dev/null",
        "interval": 1,
        "on-click": "playerctl play-pause",
        "tooltip": false
    },
    "custom/music-next": {
        "format": "󰒭",
        "exec-if": "playerctl status 2>/dev/null",
        "exec": "echo",
        "interval": 2,
        "on-click": "playerctl next",
        "tooltip": false
    },

    // ═════════ HORA (centro): bloque con la hora + fecha ═════════
    "group/time": {
        "orientation": "horizontal",
        "modules": ["clock#time", "clock#date"]
    },
    "clock#time": {
        "format": "{:%H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "format": {
                "months":   "<b>{}</b>",
                "weekdays": "<span alpha='60%'>{}</span>",
                "today":    "<b><u>{}</u></b>"
            }
        },
        "actions": { "on-scroll-up": "shift_up", "on-scroll-down": "shift_down" }
    },
    "clock#date": {
        "format": "{:L%a %d %b}",
        "locale": "es_CO.utf8",
        "tooltip": false
    },

    // ═════════ SISTEMA (cajón: se abre al pasar el mouse) ═════════
    "group/system": {
        "orientation": "horizontal",
        "drawer": { "transition-duration": 500, "transition-left-to-right": false },
        "modules": ["custom/sys-icon", "cpu", "memory", "temperature"]
    },
    "custom/sys-icon": { "format": "󰘚", "tooltip-format": "Pasa el mouse para ver el sistema" },
    "cpu": {
        "format": "cpu {usage}%",
        "interval": 2,
        "states": { "warning": 70, "critical": 90 },
        "on-click": "kitty -e btop"
    },
    "memory": {
        "format": "ram {percentage}%",
        "interval": 3,
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB",
        "states": { "warning": 75, "critical": 90 }
    },
    "temperature": {
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 85,
        "format": "{temperatureC}°c"
    },

    // ═════════ CONEXIONES: wifi + bluetooth ═════════
    "group/connect": {
        "orientation": "horizontal",
        "modules": ["network#icon", "network#name", "bluetooth"]
    },
    "network#icon": {
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "{essid} · {signalStrength}%\n {bandwidthDownBytes}   {bandwidthUpBytes}",
        "on-click": "nm-connection-editor"
    },
    "network#name": {
        "format-wifi": "{essid}",
        "format-ethernet": "cable",
        "format-disconnected": "sin red",
        "max-length": 14,
        "tooltip": false,
        "on-click": "nm-connection-editor"
    },
    "bluetooth": {
        "format": "󰂯",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-connected": "󰂱 {device_alias}",
        "format-connected-battery": "󰂱 {device_alias} {device_battery_percentage}%",
        "max-length": 22,
        "tooltip-format": "{controller_alias} · {status}",
        "tooltip-format-connected": "{controller_alias}\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "  {device_alias}",
        "on-click": "blueman-manager || kitty -e bluetoothctl",
        "on-click-right": "bluetoothctl show | grep -q 'Powered: yes' && bluetoothctl power off || bluetoothctl power on"
    },

    // ═════════ SONIDO + BRILLO ═════════
    "group/sound": {
        "orientation": "horizontal",
        "modules": ["pulseaudio#icon", "pulseaudio#vol", "backlight"]
    },
    "pulseaudio#icon": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": { "headphone": "󰋋", "default": ["󰕿", "󰖀", "󰕾"] },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip": false
    },
    "pulseaudio#vol": {
        "format": "{volume}%",
        "format-muted": "mute",
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "tooltip-format": "{desc}"
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "󰃠 {percent}%",
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    // ═════════ BATERÍA ═════════
    "group/power-cell": {
        "orientation": "horizontal",
        "modules": ["battery#icon", "battery#pct"]
    },
    "battery#icon": {
        "bat": "BAT0",
        "interval": 30,
        "states": { "warning": 25, "critical": 12 },
        "format": "{icon}",
        "format-charging": "󰂄",
        "format-plugged": "󰚥",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
        "tooltip-format": "{timeTo}"
    },
    "battery#pct": {
        "bat": "BAT0",
        "interval": 30,
        "states": { "warning": 25, "critical": 12 },
        "format": "{capacity}%",
        "tooltip-format": "{timeTo} · {power:.1f} W"
    },

    "tray": { "icon-size": 15, "spacing": 8 },

    "custom/power": {
        "format": "⏻",
        "tooltip-format": "Menú de energía",
        "on-click": "~/.config/waybar/scripts/power-menu.sh"
    }
}
