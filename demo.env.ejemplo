# Ajustes privados de la demo de Miarch. Se copia a ~/.config/miarch/personal/demo.env (permisos 600), que NO está en ningún repositorio.
# No subas ni pegues el archivo real: lleva tu contraseña.

# Contraseña de tu usuario, SOLO para que la demo la escriba sola en la pantalla de bloqueo.
# Déjala vacía y la escribirás tú a mano. Necesita el paquete "wtype" (sudo pacman -S wtype).
MIARCH_DEMO_PASS=

# Monitor donde se graba (por defecto el HDMI)
MIARCH_DEMO_PANTALLA=HDMI-A-1

# Segundos de pantalla de bloqueo que se conservan en el vídeo antes de recortar la espera (0 = no recortar)
MIARCH_DEMO_BLOQUEO_SEG=3
