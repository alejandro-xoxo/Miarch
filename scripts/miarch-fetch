#!/usr/bin/env bash
# Miarch · fastfetch que se adapta al tamaño de la ventana.
#   ancha y alta  -> logo grande + datos completos
#   mediana       -> logo pequeño + datos principales
#   angosta       -> solo datos, sin logo
#   diminuta      -> no muestra nada (no estorba)
command -v fastfetch >/dev/null 2>&1 || exit 0

medir() { read -r filas cols < <(stty size 2>/dev/null </dev/tty) || true; filas=${filas:-24}; cols=${cols:-80}; }
medir
sleep 0.1     # Hyprland acomoda la ventana justo al abrirla: se vuelve a medir con el tamaño final
medir

# Colores del escritorio (los escribe miarch-colors en la config de kitty). Si no están, usa azul.
leer_color() {   # $1 = "color16" | "color17"  ->  "38;2;R;G;B"
    local hex; hex="$(awk -v k="$1" '$1==k {print $2; exit}' "$HOME/.config/kitty/miarch-colors.conf" 2>/dev/null)"
    [[ "$hex" =~ ^#[0-9a-fA-F]{6}$ ]] && printf '38;2;%d;%d;%d' "$((16#${hex:1:2}))" "$((16#${hex:3:2}))" "$((16#${hex:5:2}))"
}
ACENTO="$(leer_color color16)"; NEUTRO="$(leer_color color17)"
if [ -n "$ACENTO" ] && [ -n "$NEUTRO" ]; then
    COLOR=(--color-keys "$ACENTO" --color-title "$ACENTO" --logo-color-1 "$ACENTO" --color-separator "$NEUTRO"
           --percent-color-green "$NEUTRO" --percent-color-yellow "$ACENTO" --percent-color-red "$ACENTO")
else
    COLOR=(--color-keys blue --color-title blue --color-separator default --logo-color-1 blue)
fi

# MIARCH_DEMO=1 (capturas): oculta usuario@equipo
TIT="Title:Separator:"; [ -n "${MIARCH_DEMO:-}" ] && TIT=""

if   (( cols >= 96 && filas >= 26 )); then
    exec fastfetch "${COLOR[@]}" --structure "${TIT}OS:Host:Kernel:Uptime:Packages:Shell:WM:Terminal:CPU:Memory:Disk:Battery"
elif (( cols >= 64 && filas >= 14 )); then
    exec fastfetch "${COLOR[@]}" --logo arch_small --structure "${TIT}OS:Kernel:Uptime:Packages:Shell:WM:Memory:Battery"
elif (( cols >= 40 && filas >= 10 )); then
    exec fastfetch "${COLOR[@]}" --logo none --structure "${TIT}OS:Kernel:Uptime:Memory"
fi
