#!/usr/bin/env bash
# Miarch · actualizador semiautomático. Lo abre el botón de actualizaciones (la nube) de la barra.
#   1. REVISA primero, sin descargar ni instalar nada: cambios nuevos de Miarch en GitHub, paquetes de Miarch que
#      faltan en este equipo y actualizaciones del sistema (repos oficiales y AUR).
#      También detecta si las configuraciones del repo aún no se aplicaron en este equipo (por ejemplo en el repo del propio
#      autor, que ya trae los cambios y nunca "descarga" nada).
#   2. Te muestra qué hay. Si no hay nada, lo dice y termina.
#   3. Si hay algo, pide UNA confirmación y hace solo lo que hace falta:
#      descarga y aplica los cambios de Miarch (conservando tus ajustes y tu fondo), instala los paquetes que faltan
#      y actualiza el sistema (yay -Syu, sin más preguntas). Después recarga el escritorio.
# Uso: miarch-update [--forzar]    (--forzar vuelve a aplicar las configuraciones aunque no haya cambios nuevos)
set -uo pipefail

# Este es un punto de entrada: empieza de cero aunque haya heredado variables de otra ejecución (si no, el tiempo del
# resumen se acumulaba de una actualización a la siguiente).
unset MIARCH_UI_INICIO MIARCH_UI_TOTAL MIARCH_UI_ACTUAL MIARCH_UI_SUB MIARCH_UI_COMPACTO MIARCH_SUDO_VIVO MIARCH_STATS

REPO="${MIARCH_DIR:-$HOME/Miarch}"
FORZAR=0; [ "${1:-}" = "--forzar" ] && FORZAR=1

fin() { echo; read -rp "Enter para cerrar " _; exit "${1:-0}"; }
si()  { local r; read -rp "  ? $1 [S/n] " r; [[ -z "$r" || "$r" =~ ^[sSyY] ]]; }
unir() { local s="" x; for x in "$@"; do s+="${s:+, }$x"; done; printf "%s" "$s"; }
plural() { [ "$1" = 1 ] && echo "$2" || echo "$3"; }

# Lee NOVEDADES.md por la entrada estándar y muestra solo el TÍTULO de las entradas que aún no has visto (marca = id de la última
# vista), una línea cada una y como máximo 3. El detalle de cada una está en NOVEDADES.md.
NOV_MARCA="$HOME/.cache/miarch/novedades-vistas"
novedades() {
    awk -v marca="$(cat "$NOV_MARCA" 2>/dev/null)" -v max=3 -v ca="${C_ACENTO:-}" -v cr="${C_R:-}" '
        /^## / { id=$2; t=$0; sub(/^## [^ ]+ · /,"",t)
                 if (id in visto) next; visto[id]=1                      # un id repetido no se muestra dos veces
                 if ((marca=="" || id>marca) && n<max) { n++; printf "      %s▸%s %s\n", ca, cr, t } }'
}
ultima_novedad() { grep -m1 '^## ' NOVEDADES.md 2>/dev/null | awk '{print $2}'; }

# Convierte una lista de archivos (uno por línea) en las partes de tu equipo que cambian, con nombres legibles.
areas() {
    local f a=()
    while IFS= read -r f; do
        case "$f" in
            config/hypr/*)        a+=("Hyprland (atajos y reglas de ventanas)") ;;
            config/quickshell/*)  a+=("el escritorio (barra, paneles y bloqueo)") ;;
            config/greeter/*)     a+=("la pantalla de inicio de sesión") ;;
            config/kitty/*)       a+=("la terminal") ;;
            config/nvim/*)        a+=("Neovim") ;;
            config/chrome/*)      a+=("Chrome") ;;
            config/vscode/*)      a+=("VS Code") ;;
            home/.zshrc)          a+=("Zsh") ;;
            packages.sh)          a+=("la lista de paquetes") ;;
            install.sh|setup.sh|lib/*) a+=("el instalador") ;;
            scripts/*)            a+=("las herramientas de Miarch") ;;
            wallpapers/*)         a+=("los fondos de pantalla") ;;
        esac
    done
    printf '%s\n' "${a[@]}" | awk '!v[$0]++'
}

[ -d "$REPO/.git" ] || { echo "[ERROR] No encuentro el repositorio de Miarch en $REPO (¿lo clonaste en otra carpeta? usa MIARCH_DIR=carpeta)"; fin 1; }
cd "$REPO"
# interfaz (logo, etapas, animación, resumen). Si el repositorio no la trae, versiones mínimas sin animación.
if [ -f "$REPO/lib/ui.sh" ]; then
    source "$REPO/lib/ui.sh"
else
    ui_banner() { :; }; ui_total() { :; }; ui_resumen() { :; }
    ui_etapa()  { printf '\n==> %s\n' "$*"; }; ui_titulo() { printf '\n==> %s\n' "$*"; }
    ui_ok()     { echo "[OK] $*"; };  ui_info() { echo "[i] $*"; }
    ui_aviso()  { echo "[!] $*"; };   ui_error() { echo "[ERROR] $*" >&2; }
    ui_ejecutar() { local m="$1"; shift; echo "   ... $m"; "$@"; }
fi
declare -F ui_titulo >/dev/null || ui_titulo() { ui_etapa "$*"; }   # librería anterior a ui_titulo
export MIARCH_UI_SUB=1      # packages.sh e install.sh no repiten el logo ni el resumen
ui_banner "actualizador"

# =====================================================================================================
# 1) REVISAR (no descarga ni instala nada)
# =====================================================================================================
ui_titulo "Revisando qué hay pendiente"
git fetch -q origin 2>/dev/null || { ui_error "No hay conexión con GitHub. Revisa el Wi-Fi y vuelve a intentarlo."; fin 1; }
RAMA="$(git rev-parse --abbrev-ref HEAD)"
UP="@{u}"; git rev-parse -q --verify "$UP" >/dev/null 2>&1 || UP="origin/$RAMA"
NUEVOS="$(git rev-list --count "HEAD..$UP" 2>/dev/null || echo 0)"
SUCIO=0; [ -n "$(git status --porcelain --untracked-files=no)" ] && SUCIO=1
CFG_MARCA="$HOME/.cache/miarch/configs-aplicadas"   # guarda el commit cuyas configuraciones se aplicaron por última vez
# Pendientes solo si cambió algo que se instala entre el commit anotado y el actual: un commit de documentación o de
# novedades no vuelve a marcar nada como pendiente.
RUTAS_CFG=(config scripts home lib install.sh setup.sh packages.sh skills AGENTS.md)
MARCA_ANT="$(cat "$CFG_MARCA" 2>/dev/null)"
CFG_PENDIENTES=1
if [ -n "$MARCA_ANT" ] && git cat-file -e "$MARCA_ANT^{commit}" 2>/dev/null && git diff --quiet "$MARCA_ANT" HEAD -- "${RUTAS_CFG[@]}"; then CFG_PENDIENTES=0; fi
# Pantalla de inicio de sesión gráfica (greetd): por defecto. Pendiente si no está activa, o si sus archivos cambiaron.
# Quien no la quiere: touch ~/.config/miarch/sin-greeter
GREETER_PEND=0
if [ ! -e "$HOME/.config/miarch/sin-greeter" ]; then
    [ "$(systemctl is-enabled greetd 2>/dev/null)" = "enabled" ] || GREETER_PEND=1
    [ "$GREETER_PEND" = 0 ] && [ -n "$MARCA_ANT" ] && ! git diff --quiet "$MARCA_ANT" "${UP:-HEAD}" -- config/greeter 2>/dev/null && GREETER_PEND=1
    # y si el instalador sabe compararse con lo instalado (sirve aunque no haya marca), se le pregunta también
    [ "$GREETER_PEND" = 0 ] && grep -q -- '--pendiente' ./scripts/miarch-greeter-install 2>/dev/null && bash ./scripts/miarch-greeter-install --pendiente && GREETER_PEND=1
fi
PAQ_CAMBIA=0; [ "$NUEVOS" -gt 0 ] && ! git diff --quiet HEAD "$UP" -- packages.sh && PAQ_CAMBIA=1

# un packages.sh antiguo no conoce --faltantes y ejecutaría la instalación completa: solo se pregunta si lo soporta
FALTAN=(); SOBRAN=()
grep -q -- '--faltantes' ./packages.sh 2>/dev/null && mapfile -t FALTAN < <(bash ./packages.sh --faltantes 2>/dev/null)
grep -q -- '--sobran' ./packages.sh 2>/dev/null && mapfile -t SOBRAN < <(bash ./packages.sh --sobran 2>/dev/null)
ui_info "Consultando las actualizaciones del sistema..."
mapfile -t SIS_OFI < <(command -v checkupdates >/dev/null && checkupdates 2>/dev/null)
mapfile -t SIS_AUR < <(command -v yay >/dev/null && timeout 40 yay -Qua 2>/dev/null)
N_SIS=$(( ${#SIS_OFI[@]} + ${#SIS_AUR[@]} ))

echo
if [ "$NUEVOS" -gt 0 ]; then
    ui_info "Miarch: $NUEVOS $(plural "$NUEVOS" 'cambio nuevo' 'cambios nuevos') en GitHub (rama $RAMA)"
    NOV_TXT="$(git show "$UP:NOVEDADES.md" 2>/dev/null | novedades)"
    if [ -n "$NOV_TXT" ]; then
        ui_info "Novedades:"; printf '%s\n' "$NOV_TXT"
    else
        git log --format='        - %s' "HEAD..$UP" | head -12          # sin novedades escritas: los títulos de los cambios
    fi
    mapfile -t AREAS < <(git diff --name-only HEAD "$UP" 2>/dev/null | areas)
    [ "${#AREAS[@]}" -gt 0 ] && ui_info "Cambia en tu equipo: $(unir "${AREAS[@]}")"
    [ "$SUCIO" = 1 ] && ui_aviso "Tienes cambios sin guardar en $REPO: no se pueden descargar sin pisarlos. Guárdalos (commit) y vuelve a intentarlo."
else
    ui_ok "Miarch: al día"
fi
if [ "$CFG_PENDIENTES" = 1 ] && [ "$NUEVOS" -eq 0 ]; then
    ui_info "Configuraciones de Miarch sin aplicar en este equipo"
    NOV_TXT="$(novedades < NOVEDADES.md 2>/dev/null)"
    [ -n "$NOV_TXT" ] && { ui_info "Novedades:"; printf '%s\n' "$NOV_TXT"; }
    MARCA_CFG="$(cat "$CFG_MARCA" 2>/dev/null)"
    if [ -n "$MARCA_CFG" ] && git cat-file -e "$MARCA_CFG^{commit}" 2>/dev/null; then
        mapfile -t AREAS < <(git diff --name-only "$MARCA_CFG" HEAD 2>/dev/null | areas)
        [ "${#AREAS[@]}" -gt 0 ] && ui_info "Cambia en tu equipo: $(unir "${AREAS[@]}")"
    fi
fi
[ "${#SOBRAN[@]}" -gt 0 ] && ui_info "Se quitará lo que Miarch ya no usa: $(unir "${SOBRAN[@]}")"
if [ "${#FALTAN[@]}" -gt 0 ]; then
    ui_info "Paquetes de Miarch que faltan en este equipo (${#FALTAN[@]}): $(unir "${FALTAN[@]}")"
elif [ "$PAQ_CAMBIA" = 1 ]; then
    ui_info "La lista de paquetes de Miarch cambió: se revisará al aplicar los cambios."
else
    ui_ok "Paquetes de Miarch: no falta ninguno"
fi
[ "$GREETER_PEND" = 1 ] && ui_info "Se instalará la pantalla de inicio de sesión de Miarch (la verás al reiniciar)"
if [ "$N_SIS" -gt 0 ]; then
    ui_info "Sistema: ${#SIS_OFI[@]} oficiales y ${#SIS_AUR[@]} de AUR por actualizar:"
    printf '%s\n' "${SIS_OFI[@]}" "${SIS_AUR[@]}" | grep -v '^$' | head -10 | sed 's/^/        - /'
    [ "$N_SIS" -gt 10 ] && echo "        ... y $(( N_SIS - 10 )) más"
else
    ui_ok "Sistema: al día"
fi

# qué se haría
HACER_MIARCH=0; { [ "$NUEVOS" -gt 0 ] && [ "$SUCIO" = 0 ]; } && HACER_MIARCH=1
# con cambios sin guardar y cambios nuevos por descargar no se intenta nada: antes se intentaba el pull y fallaba con un mensaje confuso
if [ "$FORZAR" = 1 ] || { [ "$CFG_PENDIENTES" = 1 ] && ! { [ "$NUEVOS" -gt 0 ] && [ "$SUCIO" = 1 ]; }; }; then HACER_MIARCH=1; fi
HACER_PAQ=0; { [ "${#FALTAN[@]}" -gt 0 ] || [ "${#SOBRAN[@]}" -gt 0 ] || [ "$PAQ_CAMBIA" = 1 ]; } && HACER_PAQ=1
HACER_SIS=0; [ "$N_SIS" -gt 0 ] && HACER_SIS=1
HACER_GREET=$GREETER_PEND
if [ "$HACER_MIARCH$HACER_PAQ$HACER_SIS$HACER_GREET" = "0000" ]; then
    echo
    ui_ok "Todo está al día. No hay nada que descargar ni instalar."
    ui_resumen "Todo al día"
    fin 0
fi

PLAN=()
[ "$HACER_MIARCH" = 1 ] && PLAN+=("$([ "$NUEVOS" -gt 0 ] && echo "descargar y aplicar los cambios de Miarch" || echo "aplicar las configuraciones de Miarch")")
[ "$HACER_PAQ" = 1 ]    && PLAN+=("instalar los paquetes de Miarch que faltan")
[ "$HACER_GREET" = 1 ]  && PLAN+=("instalar la pantalla de inicio de sesión")
[ "$HACER_SIS" = 1 ]    && PLAN+=("actualizar $N_SIS $(plural "$N_SIS" paquete paquetes) del sistema")
echo
si "Se va a: $(unir "${PLAN[@]}"). ¿Continuar? (pide tu contraseña si hace falta)" || { ui_info "No se hizo ningún cambio."; fin 0; }

# etapas reales = las tareas elegidas (la barra del total muestra solo lo que de verdad se hará)
UI_ACTUAL=0
UI_TOTAL=$(( HACER_MIARCH * 2 + HACER_PAQ + HACER_SIS + HACER_GREET ))
if [ "$HACER_PAQ" = 1 ] || [ "$HACER_SIS" = 1 ] || [ "$HACER_GREET" = 1 ]; then
    sudo -v || { ui_error "Sin permiso de administrador: no se instala nada."; fin 1; }
    # La contraseña de sudo caduca a los pocos minutos y compilar apps tarda más: se renueva mientras dure la actualización.
    # Sin esto, un paso posterior se quedaría esperando la contraseña, invisible bajo el indicador de progreso.
    ( while true; do sudo -n true 2>/dev/null; sleep 45; kill -0 "$$" 2>/dev/null || exit; done ) &
    SUDO_KEEPALIVE=$!
    trap 'kill "$SUDO_KEEPALIVE" 2>/dev/null' EXIT
fi

# =====================================================================================================
# 2) HACER solo lo que hace falta
# =====================================================================================================
if [ "$HACER_MIARCH" = 1 ]; then
    if [ "$NUEVOS" -gt 0 ]; then
        ui_etapa "Descargando los cambios de Miarch"
        if ui_ejecutar "Descargando $NUEVOS $(plural "$NUEVOS" cambio cambios) de GitHub" git pull -q --ff-only; then :; else
            ui_aviso "No se pudo descargar sin conflictos (tu copia local tiene commits propios). No se aplicó nada de Miarch."
            HACER_MIARCH=0; UI_TOTAL=$(( UI_TOTAL - 1 ))
        fi
    else
        ui_etapa "Revisando los archivos de Miarch"
        ui_info "Sin cambios nuevos que descargar: se aplican los archivos que ya tienes."
    fi
fi
if [ "$HACER_MIARCH" = 1 ]; then
    ui_etapa "Aplicando los cambios de Miarch (se conservan tus ajustes y tu fondo)"
    HYPR="$HOME/.config/hypr/hyprland.lua"
    GUARDADOS="$(grep -E '^local (ESCALA|KB|NATURAL|TAP|SENS|CURSOR|MOVIMIENTO|ANIM|BLUR)[[:space:]]*=' "$HYPR" 2>/dev/null || true)"
    if MIARCH_ACTUALIZANDO=1 ui_ejecutar "Copiando configuraciones y scripts" bash ./install.sh; then
        mkdir -p "$(dirname "$CFG_MARCA")"; git rev-parse HEAD > "$CFG_MARCA"
        [ -n "$(ultima_novedad)" ] && ultima_novedad > "$NOV_MARCA"      # ya viste las novedades hasta esta
    else
        ui_aviso "install.sh terminó con avisos (arriba están las últimas líneas). Se volverá a intentar la próxima vez."
    fi
    if [ -n "$GUARDADOS" ] && [ -f "$HYPR" ]; then
        GUARDADOS="$GUARDADOS" python3 -I - "$HYPR" <<'PY'
import os, re, sys
ruta = sys.argv[1]
txt = open(ruta, encoding="utf-8").read()
for ln in os.environ["GUARDADOS"].splitlines():
    nombre = re.match(r"local (\w+)", ln).group(1)
    valor = re.match(r"local \w+\s*=\s*(\"[^\"]*\")", ln)
    if valor:   # solo el valor; el comentario de la línea nueva se conserva
        txt = re.sub(r'(?m)^(local %s\s*=\s*)"[^"]*"' % nombre, lambda m: m.group(1) + valor.group(1), txt)
open(ruta, "w", encoding="utf-8").write(txt)
PY
        ui_ok "Tus ajustes (animaciones, blur, escala, teclado...) se conservaron"
    fi
    RECARGAR=1      # se recarga al final, cuando ya están instalados los paquetes nuevos (Quickshell o Hyprland pueden haberse actualizado)
fi

if [ "$HACER_PAQ" = 1 ]; then
    # la lista pudo cambiar con la descarga: se vuelve a mirar qué falta de verdad
    FALTAN=(); SOBRAN=()
    grep -q -- '--faltantes' ./packages.sh 2>/dev/null && mapfile -t FALTAN < <(bash ./packages.sh --faltantes 2>/dev/null)
    grep -q -- '--sobran' ./packages.sh 2>/dev/null && mapfile -t SOBRAN < <(bash ./packages.sh --sobran 2>/dev/null)
    if [ "${#FALTAN[@]}" -gt 0 ] || [ "${#SOBRAN[@]}" -gt 0 ]; then
        if [ "${#FALTAN[@]}" -gt 0 ]; then
            ui_etapa "Instalando ${#FALTAN[@]} $(plural "${#FALTAN[@]}" 'paquete que faltaba' 'paquetes que faltaban'): $(unir "${FALTAN[@]}")"
        else
            ui_etapa "Quitando lo que Miarch ya no usa: $(unir "${SOBRAN[@]}")"
        fi
        MIARCH_UI_COMPACTO=1 bash ./packages.sh || ui_aviso "packages.sh terminó con errores (arriba). Se volverá a ofrecer la próxima vez."
    else
        ui_etapa "Revisando los paquetes de Miarch"
        ui_ok "No falta ningún paquete: no se instala nada"
    fi
fi

if [ "$HACER_GREET" = 1 ]; then
    ui_etapa "Instalando la pantalla de inicio de sesión (se ve al reiniciar)"
    if [ -x ./scripts/miarch-greeter-install ]; then
        MIARCH_SUDO_VIVO=1 ui_ejecutar "Instalando greetd y la pantalla de Miarch" bash ./scripts/miarch-greeter-install \
            || ui_aviso "No se pudo instalar la pantalla de inicio de sesión. Sigues entrando por la terminal; reintenta con ./scripts/miarch-greeter-install"
    else
        ui_aviso "Este Miarch aún no trae la pantalla de inicio de sesión: descarga los cambios y vuelve a intentarlo."
    fi
fi

if [ "$HACER_SIS" = 1 ]; then
    ui_etapa "Actualizando $N_SIS $(plural "$N_SIS" paquete paquetes) del sistema"
    ui_ejecutar "Actualizando el sistema (yay -Syu)" yay -Syu --noconfirm || ui_aviso "La actualización del sistema falló (arriba están las últimas líneas)."
fi

if [ "${RECARGAR:-0}" = 1 ] && [ -z "${MIARCH_SIN_REINICIO:-}" ]; then
    hyprctl reload >/dev/null 2>&1 || true
    qs kill -c miarch >/dev/null 2>&1; sleep 1
    # Quickshell queda vivo mucho tiempo y lanza el siguiente actualizador: no debe heredar las variables de ESTA ejecución
    (env -u MIARCH_UI_INICIO -u MIARCH_UI_TOTAL -u MIARCH_UI_ACTUAL -u MIARCH_UI_SUB -u MIARCH_UI_COMPACTO -u MIARCH_SUDO_VIVO -u MIARCH_STATS setsid qs -c miarch >/dev/null 2>&1 &)
    ui_ok "Hyprland y el escritorio recargados"
fi

ui_resumen "Actualización completa"
fin 0
