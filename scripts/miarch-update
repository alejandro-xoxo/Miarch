#!/usr/bin/env bash
# Miarch · actualizador semiautomático (al estilo de omarchy-update). Lo abre el botón de actualizaciones de la barra.
#   1. Busca cambios nuevos de Miarch en GitHub y los baja.
#   2. Aplica las configuraciones y scripts nuevos, conservando tus ajustes (animaciones, blur, escala, teclado...) y tu fondo.
#   3. Si hay paquetes nuevos, pregunta antes de instalarlos (pide contraseña).
#   4. Pregunta si actualizas también el sistema (yay -Syu, sin más preguntas).
#   5. Recarga Hyprland y el escritorio.
# Uso: miarch-update [--forzar]    (--forzar vuelve a aplicar las configuraciones aunque no haya cambios nuevos)
set -uo pipefail

REPO="${MIARCH_DIR:-$HOME/Miarch}"
FORZAR=0; [ "${1:-}" = "--forzar" ] && FORZAR=1
CACHE="$HOME/.cache/miarch"; mkdir -p "$CACHE"

fin()   { echo; read -rp "Enter para cerrar " _; exit "${1:-0}"; }
si()    { local r; read -rp "  ? $1 [S/n] " r; [[ -z "$r" || "$r" =~ ^[sSyY] ]]; }

[ -d "$REPO/.git" ] || { echo "[ERROR] No encuentro el repositorio de Miarch en $REPO (¿lo clonaste en otra carpeta? usa MIARCH_DIR=carpeta)"; fin 1; }
cd "$REPO"
# interfaz (logo, etapas, animación, resumen). Si el repositorio no la trae, versiones mínimas sin animación.
if [ -f "$REPO/lib/ui.sh" ]; then
    source "$REPO/lib/ui.sh"
else
    ui_banner() { :; }; ui_total() { :; }; ui_resumen() { :; }
    ui_etapa()  { printf '\n==> %s\n' "$*"; }
    ui_ok()     { echo "[OK] $*"; };  ui_info() { echo "[i] $*"; }
    ui_aviso()  { echo "[!] $*"; };   ui_error() { echo "[ERROR] $*" >&2; }
fi
export MIARCH_UI_SUB=1      # packages.sh e install.sh no repiten el logo ni el resumen
ui_total 5
ui_banner "actualizador"

ui_etapa "Buscando cambios de Miarch"
git fetch -q origin 2>/dev/null || { ui_error "No hay conexión con GitHub. Revisa el Wi-Fi y vuelve a intentarlo."; fin 1; }
RAMA="$(git rev-parse --abbrev-ref HEAD)"
UP="@{u}"; git rev-parse -q --verify "$UP" >/dev/null 2>&1 || UP="origin/$RAMA"
NUEVOS="$(git rev-list --count "HEAD..$UP" 2>/dev/null || echo 0)"

if [ "$NUEVOS" -gt 0 ]; then
    ui_info "$NUEVOS cambio(s) nuevo(s) en la rama $RAMA:"
    git log --format='      - %s' "HEAD..$UP" | head -15
    if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
        ui_aviso "Tienes cambios sin guardar en $REPO: no se descargan para no pisarlos."
        ui_info "Guárdalos (commit) o descártalos y vuelve a ejecutar la actualización."
        NUEVOS=0
    elif git pull -q --ff-only 2>/dev/null; then
        ui_ok "Cambios descargados"
    else
        ui_aviso "No se pudo descargar sin conflictos (tu copia local tiene commits propios)."
        NUEVOS=0
    fi
else
    ui_ok "Miarch ya está al día"
fi

# --- configuraciones y scripts ---
ui_etapa "Aplicando configuraciones"
if [ "$NUEVOS" -gt 0 ] || [ "$FORZAR" = 1 ]; then
    HYPR="$HOME/.config/hypr/hyprland.lua"
    GUARDADOS="$(grep -E '^local (ESCALA|KB|NATURAL|TAP|SENS|CURSOR|MOVIMIENTO|ANIM|BLUR)[[:space:]]*=' "$HYPR" 2>/dev/null || true)"
    if declare -F ui_ejecutar >/dev/null; then
        MIARCH_ACTUALIZANDO=1 ui_ejecutar "Aplicando configuraciones (se conservan tus ajustes y tu fondo)" bash ./install.sh || ui_aviso "install.sh terminó con avisos (arriba están las últimas líneas)."
    else
        MIARCH_ACTUALIZANDO=1 bash ./install.sh >"$CACHE/update-install.log" 2>&1 && ui_ok "Configuraciones aplicadas" || ui_aviso "install.sh terminó con avisos: mira $CACHE/update-install.log"
    fi
    if [ -n "$GUARDADOS" ] && [ -f "$HYPR" ]; then
        GUARDADOS="$GUARDADOS" python3 -I - "$HYPR" <<'PY'
import os, re, sys
ruta = sys.argv[1]
txt = open(ruta, encoding="utf-8").read()
for ln in os.environ["GUARDADOS"].splitlines():
    nombre = re.match(r"local (\w+)", ln).group(1)
    valor = re.match(r"local \w+\s*=\s*(\"[^\"]*\")", ln)
    if valor:   # solo el valor; el comentario de la línea nueva se conserva
        txt = re.sub(r'(?m)^(local %s\s*=\s*)"[^"]*"' % nombre, lambda m: m.group(1) + valor.group(1), txt)
open(ruta, "w", encoding="utf-8").write(txt)
PY
        ui_ok "Tus ajustes (animaciones, blur, escala, teclado...) se conservaron"
    fi
else
    ui_info "Sin cambios nuevos que aplicar (clic derecho en la nube fuerza volver a aplicar)"
fi

# --- paquetes nuevos del repositorio ---
ui_etapa "Paquetes de Miarch"
SHA_ACTUAL="$(sha256sum packages.sh | cut -d' ' -f1)"
SHA_ANTES="$(cat "$CACHE/packages.sha" 2>/dev/null || true)"
if [ -z "$SHA_ANTES" ]; then
    echo "$SHA_ACTUAL" > "$CACHE/packages.sha"           # primera vez: se toma la lista actual como ya instalada
    ui_ok "Lista de paquetes al día"
elif [ "$SHA_ANTES" != "$SHA_ACTUAL" ]; then
    ui_info "La lista de paquetes de Miarch cambió."
    if si "¿Instalar los paquetes nuevos ahora? (pide tu contraseña)"; then
        if bash ./packages.sh; then echo "$SHA_ACTUAL" > "$CACHE/packages.sha"; else ui_aviso "packages.sh terminó con errores (arriba). Se volverá a ofrecer la próxima vez."; fi
    else
        ui_info "Salteado. Se volverá a ofrecer la próxima vez."
    fi
else
    ui_ok "Lista de paquetes al día"
fi

# --- sistema ---
ui_etapa "Actualizaciones del sistema"
if command -v yay >/dev/null && si "¿Actualizar también el sistema (yay -Syu)? Es automático, no hace más preguntas"; then
    # --noconfirm: sin preguntas técnicas (antes yay se quedaba esperando "Paquetes a excluir" y parecía colgado)
    if sudo -v; then
        if declare -F ui_ejecutar >/dev/null; then
            ui_ejecutar "Actualizando el sistema (yay -Syu)" yay -Syu --noconfirm || ui_aviso "La actualización del sistema falló (arriba están las últimas líneas)."
        else
            yay -Syu --noconfirm || ui_aviso "La actualización del sistema falló."
        fi
    else
        ui_aviso "Sin permiso de administrador: se omite la actualización del sistema."
    fi
else
    ui_info "Sistema sin actualizar"
fi

# --- recargar ---
ui_etapa "Recargando el escritorio"
if [ -z "${MIARCH_SIN_REINICIO:-}" ]; then
    hyprctl reload >/dev/null 2>&1 || true
    qs kill -c miarch >/dev/null 2>&1; sleep 1
    (setsid qs -c miarch >/dev/null 2>&1 &)
    ui_ok "Hyprland y el escritorio recargados"
fi
ui_resumen "Actualización completa"
fin 0
