#!/usr/bin/env python3
"""Miarch · puente entre el panel de Quickshell e iwd (iwctl). Todas las salidas son JSON.
  miarch-wifi list                 → {power, iface, redes:[{nombre,seguridad,senal,conectada,conocida}]}
  miarch-wifi scan
  miarch-wifi connect "RED"        → usa la variable de entorno MIARCH_PASS si la red necesita clave
  miarch-wifi disconnect
  miarch-wifi power on|off
  miarch-wifi forget "RED"
"""
import json, os, pty, re, select, signal, subprocess, sys, time

ANSI = re.compile(r"\x1b\[[0-9;]*m")

def iw(*args, extra=None):
    cmd = ["iwctl"] + (extra or []) + list(args)
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=25)
    return r.returncode, ANSI.sub("", r.stdout + r.stderr)

def ejecutar_con_clave(cmd, clave, esperar=b"Passphrase:", limite=40):
    """Ejecuta cmd en una terminal virtual (pty) y escribe la clave cuando aparece el aviso,
    exactamente como si la tecleara una persona. La clave NUNCA va en los argumentos del
    comando (los argumentos de un proceso los puede leer cualquier usuario del equipo)."""
    pid, fd = pty.fork()
    if pid == 0:                                   # hijo: no hereda la clave en su entorno
        os.environ.pop("MIARCH_PASS", None)
        os.execvp(cmd[0], cmd)
    buf, enviada, vencido = b"", False, True
    fin = time.time() + limite
    try:
        while time.time() < fin:
            listo, _, _ = select.select([fd], [], [], 0.5)
            if not listo:
                continue
            try:
                datos = os.read(fd, 4096)
            except OSError:                        # el hijo terminó (EIO en el pty)
                vencido = False
                break
            if not datos:
                vencido = False
                break
            buf += datos
            if not enviada and esperar in buf:
                os.write(fd, clave.encode() + b"\n")
                enviada, buf = True, b""           # descarta lo anterior, incluido cualquier eco
    finally:
        os.close(fd)
    if vencido:
        try: os.kill(pid, signal.SIGKILL)
        except OSError: pass
    _, estado = os.waitpid(pid, 0)
    rc = os.waitstatus_to_exitcode(estado)
    texto = ANSI.sub("", buf.decode(errors="replace"))
    if clave:
        texto = texto.replace(clave, "•" * len(clave))
    return rc, texto, enviada

def interfaz():
    _, out = iw("device", "list")
    for ln in out.splitlines():
        p = ln.split()
        if p and p[0].startswith(("wlan", "wlp", "wlx")):
            return p[0]
    return "wlan0"

def columnas(ln):
    return re.split(r"\s{2,}", ln.strip())

def tabla(out):
    """Devuelve las filas de datos (después de la 3.ª línea de guiones)."""
    filas, guiones = [], 0
    for ln in out.splitlines():
        if set(ln.strip()) == {"-"}:
            guiones += 1
            continue
        if guiones >= 2 and ln.strip():
            filas.append(ln)
    return filas

def listar(IF):
    _, dev = iw("station", IF, "show")
    _, pw = iw("device", IF, "show")
    encendido = bool(re.search(r"Powered\s+on", pw))
    _, k = iw("known-networks", "list")
    conocidas = {columnas(f)[0] for f in tabla(k) if columnas(f)}
    _, g = iw("station", IF, "get-networks")
    redes = []
    for ln in tabla(g):
        conectada = ln[2:3] == ">"
        c = columnas(ln[3:] if len(ln) > 3 else ln)
        if len(c) < 2:
            continue
        nombre, seg = c[0], c[1]
        senal = c[2].count("*") if len(c) > 2 else 0
        redes.append({"nombre": nombre, "seguridad": seg, "senal": senal,
                      "conectada": conectada, "conocida": nombre in conocidas})
    redes.sort(key=lambda r: (not r["conectada"], not r["conocida"], -r["senal"], r["nombre"].lower()))
    return {"power": encendido, "iface": IF, "redes": redes}

def conectar(IF, nombre):
    clave = os.environ.get("MIARCH_PASS", "")
    enviada, texto, rc = False, "", 1
    for intento in (1, 2):
        if clave:
            rc, out, enviada = ejecutar_con_clave(["iwctl", "station", IF, "connect", nombre], clave)
        else:
            rc, out = iw("station", IF, "connect", nombre)
        texto = out.strip()
        # Justo después de arrancar, iwd aún no "ve" la red: se busca de nuevo y se reintenta una vez
        if "invalid network name" in texto.lower() and intento == 1:
            iw("station", IF, "scan")
            time.sleep(4)
            continue
        break
    bajo = texto.lower()
    if rc == 0 and "failed" not in bajo and "invalid" not in bajo:
        return {"ok": True, "msg": ""}
    if "invalid network name" in bajo:
        msg = "No se encuentra esa red ahora. Acércate al router e inténtalo de nuevo"
    elif "not configured" in bajo or "no agent" in bajo:
        msg = "iwd no pudo pedir la contraseña. Reinicia el servicio iwd"
    elif enviada:
        msg = "No se pudo conectar. Revisa la contraseña"
    elif texto:
        msg = texto.splitlines()[-1][:80]
    else:
        msg = "No se pudo conectar"
    return {"ok": False, "msg": msg}

def main():
    if len(sys.argv) < 2:
        sys.exit(__doc__)
    cmd, IF = sys.argv[1], interfaz()
    a = sys.argv[2] if len(sys.argv) > 2 else ""
    if cmd == "list":
        res = listar(IF)
    elif cmd == "scan":
        iw("station", IF, "scan"); res = {"ok": True}
    elif cmd == "connect":
        res = conectar(IF, a)
    elif cmd == "disconnect":
        iw("station", IF, "disconnect"); res = {"ok": True}
    elif cmd == "power":
        rc, _ = iw("device", IF, "set-property", "Powered", "on" if a == "on" else "off"); res = {"ok": rc == 0}
    elif cmd == "forget":
        rc, _ = iw("known-networks", a, "forget"); res = {"ok": rc == 0}
    else:
        sys.exit(__doc__)
    print(json.dumps(res, ensure_ascii=False))

if __name__ == "__main__":
    main()
