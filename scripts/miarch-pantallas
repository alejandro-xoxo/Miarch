#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Miarch · gestión y ordenación de pantallas para Hyprland y Quickshell.
Todas las salidas son JSON.
  miarch-pantallas list
  miarch-pantallas swap
  miarch-pantallas orden NOMBRE_IZQ NOMBRE_DER
  miarch-pantallas principal NOMBRE
  miarch-pantallas identificar
"""

import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time

REGEX_NOMBRE = re.compile(r"^[A-Za-z0-9._-]+$")
MAX_LOG_BYTES = 100 * 1024


def registrar_log(mensaje: str) -> None:
    try:
        log_dir = Path.home() / ".cache" / "miarch"
        log_dir.mkdir(parents=True, exist_ok=True)
        log_file = log_dir / "pantallas.log"

        if log_file.exists() and log_file.stat().st_size > MAX_LOG_BYTES:
            try:
                with open(log_file, "rb") as f:
                    f.seek(-50 * 1024, os.SEEK_END)
                    resto = f.read()
                corte = resto.find(b"\n")
                if corte != -1:
                    resto = resto[corte + 1:]
                with open(log_file, "wb") as f:
                    f.write(resto)
            except OSError:
                pass

        ts = time.strftime("%Y-%m-%d %H:%M:%S")
        with open(log_file, "a", encoding="utf-8") as f:
            f.write(f"[{ts}] {mensaje}\n")
    except OSError:
        pass


def obtener_ajustes() -> dict:
    ruta = Path.home() / ".config" / "miarch" / "ajustes.json"
    if not ruta.is_file():
        return {}
    try:
        with open(ruta, "r", encoding="utf-8") as f:
            d = json.load(f)
            return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def guardar_ajustes(d: dict) -> None:
    ruta = Path.home() / ".config" / "miarch" / "ajustes.json"
    ruta.parent.mkdir(parents=True, exist_ok=True)
    tmp = ruta.with_suffix(".tmp")
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(d, f, indent=2, ensure_ascii=False)
        f.write("\n")
    os.replace(tmp, ruta)


def obtener_monitores_hyprctl() -> list:
    try:
        r = subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True, check=True)
        datos = json.loads(r.stdout)
        if isinstance(datos, list):
            return datos
    except Exception as e:
        registrar_log(f"error al consultar hyprctl: {e}")
    return []


def guardar_pantallas_lua(posiciones: dict) -> None:
    ruta = Path.home() / ".config" / "miarch" / "pantallas.lua"
    ruta.parent.mkdir(parents=True, exist_ok=True)
    lineas = [
        "-- SPDX-License-Identifier: GPL-3.0-or-later",
        "-- Posiciones de pantallas generadas por miarch-pantallas.",
        "return {",
    ]
    for nombre in sorted(posiciones.keys()):
        pos = posiciones[nombre]
        lineas.append(f'    ["{nombre}"] = {{ x = {pos["x"]}, y = {pos["y"]} }},')
    lineas.append("}")
    lineas.append("")

    tmp = ruta.with_suffix(".tmp")
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("\n".join(lineas))
    os.replace(tmp, ruta)


def aplicar_en_caliente(posiciones: dict, monitores_dict: dict) -> bool:
    fallos = 0
    for nombre, pos in posiciones.items():
        m = monitores_dict.get(nombre)
        if not m:
            continue
        hz = float(m.get("refreshRate", 60.0))
        modo = f"{m.get('width', 1920)}x{m.get('height', 1080)}@{hz:.2f}"
        pos_str = f"{pos['x']}x{pos['y']}"
        escala = m.get("scale", 1)
        spec = f"{nombre},{modo},{pos_str},{escala}"
        try:
            r = subprocess.run(["hyprctl", "keyword", "monitor", spec], capture_output=True, text=True)
            if r.returncode != 0:
                fallos += 1
        except Exception:
            fallos += 1

    if fallos > 0:
        try:
            subprocess.run(["hyprctl", "reload"], capture_output=True, text=True)
        except Exception:
            return False
    return True


def cmd_list() -> None:
    monitores = obtener_monitores_hyprctl()
    ajustes = obtener_ajustes()
    principal_cfg = ajustes.get("principal")

    # Ordenar de izquierda a derecha según coordenada x
    monitores_ord = sorted(monitores, key=lambda m: m.get("x", 0))
    total = len(monitores_ord)

    lista = []
    for idx, m in enumerate(monitores_ord):
        nombre = m.get("name", "")
        marca = (m.get("make") or "").strip()
        modelo = (m.get("model") or "").strip()
        desc = (m.get("description") or "").strip()
        marca_modelo = f"{marca} {modelo}".strip() or desc or nombre

        ancho = int(m.get("width", 1920))
        alto = int(m.get("height", 1080))
        escala = float(m.get("scale", 1.0)) or 1.0
        ancho_logico = int(round(ancho / escala))
        alto_logico = int(round(alto / escala))

        if total <= 1:
            lado = "única"
        elif idx == 0:
            lado = "izquierda"
        elif idx == total - 1:
            lado = "derecha"
        else:
            lado = "centro"

        if principal_cfg:
            es_principal = (nombre == principal_cfg)
        else:
            es_principal = bool(m.get("focused", False) or idx == 0)

        lista.append({
            "nombre": nombre,
            "marca_modelo": marca_modelo,
            "marca": marca,
            "modelo": modelo,
            "descripcion": desc,
            "resolucion": f"{ancho}x{alto}",
            "ancho": ancho,
            "alto": alto,
            "frecuencia": round(float(m.get("refreshRate", 60.0)), 2),
            "escala": escala,
            "posicion": f"{m.get('x', 0)}x{m.get('y', 0)}",
            "x": int(m.get("x", 0)),
            "y": int(m.get("y", 0)),
            "ancho_logico": ancho_logico,
            "alto_logico": alto_logico,
            "foco": bool(m.get("focused", False)),
            "lado": lado,
            "es_principal": es_principal,
        })

    salida = {
        "ok": True,
        "monitores": lista,
        "total": total,
        "principal": principal_cfg or (lista[0]["nombre"] if lista else None),
    }
    print(json.dumps(salida, ensure_ascii=False))


def cmd_swap() -> None:
    monitores = obtener_monitores_hyprctl()
    if len(monitores) < 2:
        print(json.dumps({"ok": False, "msg": "Solo hay una pantalla conectada"}, ensure_ascii=False))
        return

    monitores_dict = {m.get("name"): m for m in monitores if m.get("name")}
    monitores_ord = sorted(monitores, key=lambda m: m.get("x", 0))

    # El de la izquierda pasa a la derecha y viceversa
    m_izq = monitores_ord[0]
    m_der = monitores_ord[1]

    nuevo_izq = m_der
    nuevo_der = m_izq

    nom_izq = nuevo_izq.get("name")
    nom_der = nuevo_der.get("name")

    esc_izq = float(nuevo_izq.get("scale", 1.0)) or 1.0
    ancho_log_izq = int(round(int(nuevo_izq.get("width", 1920)) / esc_izq))

    posiciones = {
        nom_izq: {"x": 0, "y": 0},
        nom_der: {"x": ancho_log_izq, "y": 0},
    }

    guardar_pantallas_lua(posiciones)
    aplicar_en_caliente(posiciones, monitores_dict)
    registrar_log(f"swap: {nom_izq} a la izquierda (0,0), {nom_der} a la derecha ({ancho_log_izq},0)")

    print(json.dumps({
        "ok": True,
        "msg": "Pantallas intercambiadas de lado",
        "posiciones": posiciones,
    }, ensure_ascii=False))


def cmd_orden(nom_izq: str, nom_der: str) -> None:
    if not REGEX_NOMBRE.match(nom_izq) or not REGEX_NOMBRE.match(nom_der):
        print(json.dumps({"ok": False, "msg": "Nombre de monitor inválido"}, ensure_ascii=False))
        sys.exit(1)

    if nom_izq == nom_der:
        print(json.dumps({"ok": False, "msg": "Los monitores deben ser diferentes"}, ensure_ascii=False))
        sys.exit(1)

    monitores = obtener_monitores_hyprctl()
    monitores_dict = {m.get("name"): m for m in monitores if m.get("name")}

    if nom_izq not in monitores_dict:
        print(json.dumps({"ok": False, "msg": f"El monitor '{nom_izq}' no está conectado"}, ensure_ascii=False))
        sys.exit(1)

    if nom_der not in monitores_dict:
        print(json.dumps({"ok": False, "msg": f"El monitor '{nom_der}' no está conectado"}, ensure_ascii=False))
        sys.exit(1)

    m_izq = monitores_dict[nom_izq]
    esc_izq = float(m_izq.get("scale", 1.0)) or 1.0
    ancho_log_izq = int(round(int(m_izq.get("width", 1920)) / esc_izq))

    posiciones = {
        nom_izq: {"x": 0, "y": 0},
        nom_der: {"x": ancho_log_izq, "y": 0},
    }

    guardar_pantallas_lua(posiciones)
    aplicar_en_caliente(posiciones, monitores_dict)
    registrar_log(f"orden: {nom_izq} a la izquierda (0,0), {nom_der} a la derecha ({ancho_log_izq},0)")

    print(json.dumps({
        "ok": True,
        "msg": "Orden de pantallas aplicado",
        "posiciones": posiciones,
    }, ensure_ascii=False))


def cmd_principal(nombre: str) -> None:
    if not REGEX_NOMBRE.match(nombre):
        print(json.dumps({"ok": False, "msg": f"Nombre de monitor inválido: {nombre}"}, ensure_ascii=False))
        sys.exit(1)

    monitores = obtener_monitores_hyprctl()
    monitores_dict = {m.get("name"): m for m in monitores if m.get("name")}

    if nombre not in monitores_dict:
        print(json.dumps({"ok": False, "msg": f"El monitor '{nombre}' no está conectado"}, ensure_ascii=False))
        sys.exit(1)

    ajustes = obtener_ajustes()
    ajustes["principal"] = nombre
    guardar_ajustes(ajustes)

    try:
        subprocess.run(["hyprctl", "dispatch", "focusmonitor", nombre], capture_output=True, text=True)
    except Exception:
        pass

    registrar_log(f"principal: monitor principal establecido en {nombre}")

    print(json.dumps({
        "ok": True,
        "msg": f"Monitor {nombre} establecido como principal",
        "principal": nombre,
    }, ensure_ascii=False))


def cmd_identificar() -> None:
    try:
        subprocess.run(["qs", "-c", "miarch", "ipc", "call", "pantallas", "identificar"], capture_output=True, text=True)
    except Exception:
        pass
    registrar_log("identificar: señal IPC enviada a Quickshell")
    print(json.dumps({"ok": True, "msg": "Identificando pantallas"}, ensure_ascii=False))


def main() -> None:
    if len(sys.argv) < 2:
        print(json.dumps({
            "ok": False,
            "msg": "Uso: miarch-pantallas <list|swap|orden|principal|identificar> [args...]",
        }, ensure_ascii=False))
        sys.exit(1)

    subcmd = sys.argv[1]
    if subcmd == "list":
        cmd_list()
    elif subcmd == "swap":
        cmd_swap()
    elif subcmd == "orden":
        if len(sys.argv) < 4:
            print(json.dumps({"ok": False, "msg": "Uso: miarch-pantallas orden NOMBRE_IZQ NOMBRE_DER"}, ensure_ascii=False))
            sys.exit(1)
        cmd_orden(sys.argv[2], sys.argv[3])
    elif subcmd == "principal":
        if len(sys.argv) < 3:
            print(json.dumps({"ok": False, "msg": "Uso: miarch-pantallas principal NOMBRE"}, ensure_ascii=False))
            sys.exit(1)
        cmd_principal(sys.argv[2])
    elif subcmd == "identificar":
        cmd_identificar()
    else:
        print(json.dumps({"ok": False, "msg": f"Comando desconocido: {subcmd}"}, ensure_ascii=False))
        sys.exit(1)


if __name__ == "__main__":
    main()
