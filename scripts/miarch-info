#!/usr/bin/env python3
"""Miarch · información del equipo en JSON (para la página Sistema del panel de Ajustes)."""
import json, os, platform, shutil, socket, subprocess

def leer(ruta, defecto=""):
    try:
        with open(ruta) as f: return f.read()
    except OSError: return defecto

def sh(*cmd):
    try: return subprocess.run(cmd, capture_output=True, text=True, timeout=5).stdout.strip()
    except Exception: return ""

mem = {l.split(":")[0]: int(l.split()[1]) for l in leer("/proc/meminfo").splitlines() if ":" in l}
cpu = next((l.split(":", 1)[1].strip() for l in leer("/proc/cpuinfo").splitlines() if l.startswith("model name")), "")
distro = next((l.split("=", 1)[1].strip('"') for l in leer("/etc/os-release").splitlines() if l.startswith("PRETTY_NAME=")), "Linux")
seg = float(leer("/proc/uptime", "0 0").split()[0])
disco = shutil.disk_usage("/")
bat = leer("/sys/class/power_supply/BAT0/capacity").strip()
perfil = sh("busctl", "--system", "get-property", "net.hadess.PowerProfiles", "/net/hadess/PowerProfiles",
            "net.hadess.PowerProfiles", "ActiveProfile").replace("s ", "").strip('"')
print(json.dumps({
    "equipo": socket.gethostname(),
    "usuario": os.environ.get("USER", ""),
    "sistema": distro,
    "kernel": platform.release(),
    "cpu": cpu,
    "ram_total": round(mem.get("MemTotal", 0) / 1048576, 1),
    "ram_usada": round((mem.get("MemTotal", 0) - mem.get("MemAvailable", 0)) / 1048576, 1),
    "disco_total": round(disco.total / 1e9),
    "disco_usado": round(disco.used / 1e9),
    "encendido": f"{int(seg // 3600)} h {int(seg % 3600 // 60)} min",
    "zona": sh("timedatectl", "show", "-p", "Timezone", "--value"),
    "idioma": os.environ.get("LANG", ""),
    "bateria": int(bat) if bat.isdigit() else None,
    "perfil": perfil,
}, ensure_ascii=False))
